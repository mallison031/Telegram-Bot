# Copy this file to .env and fill in your credentials

# Get from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Get from Groq (https://console.groq.com/keys) - free tier, no card needed
GROQ_API_KEY=your-groq-api-key-here

# --- Live prices ---
#
# Crypto comes from Coinbase's public API — no key, no account, no quota.
#
# Metals and forex come from Swissquote's public live quotes, with Yahoo
# Finance as the forex fallback. Indices and oil are not monitored: no free
# feed tracks their CFD prices in real time.
# All feeds are 100% public, keyless, and free.

# --- Broker execution: SHELVED ---
#
# broker_api.py is still in the repo but bot.py no longer calls it, so the
# BROKER_* variables have no effect. See MT5_MOBILE_AUTOMATION.md before
# wiring it back up.

# --- Optional settings (defaults shown) ---

# How often to poll live quotes (metals, forex), in seconds. Crypto candles
# are polled every 15 s regardless. Requests scale with the number of distinct
# symbols being watched, not the number of trades.
#MONITOR_INTERVAL=5

# Stop monitoring a trade after this many hours with no TP/SL (0 = never)
#TRADE_TTL_HOURS=72

# Where to persist chat IDs and monitored trades. Point this at a mounted
# persistent disk if you want state to survive redeploys.
#STATE_FILE=state.json


