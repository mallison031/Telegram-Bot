# Copy this file to .env and fill in your credentials

# Get from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Get from Google AI Studio (https://aistudio.google.com/apikey) - free tier
GEMINI_API_KEY=your-gemini-api-key-here

# --- Live prices ---
#
# Crypto and gold come from Bybit's public API — no key, no account, no quota.
#
# Forex (EURUSD, GBPUSD...) needs Twelve Data, which Bybit doesn't list.
# Free key, no card: https://twelvedata.com/ -> sign up -> API key.
#TWELVEDATA_API_KEY=your-twelvedata-key-here

# Free tier allows 800 credits/day and each pair costs one credit per poll.
# Polling is paced to fit this budget; lower it to be more conservative.
#TWELVEDATA_DAILY_CREDITS=700

# Forex, indices (^DJI, ^GSPC...), oil (CL=F, BZ=F), and gold are monitored
# automatically via Yahoo Finance public API (no key, no account, no login needed).

# --- Optional settings (defaults shown) ---

# IANA timezone for the scheduled motivation messages (defaults to West Africa Time WAT).
#TIMEZONE=Africa/Lagos

# Hour of the day (0-23, in TIMEZONE) for each scheduled message (defaults to 8 AM and 8 PM WAT)
#MORNING_HOUR=8
#NIGHT_HOUR=20

# Stop monitoring a trade after this many hours with no TP/SL (0 = never)
#TRADE_TTL_HOURS=72

# Where to persist chat IDs and monitored trades. Point this at a mounted
# persistent disk if you want state to survive redeploys.
#STATE_FILE=state.json


