# Copy this file to .env and fill in your credentials

# Get from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Get from Groq (https://console.groq.com/keys) - free tier, no card needed
GROQ_API_KEY=your-groq-api-key-here

# --- Live prices ---
#
# Crypto comes from Coinbase's public API — no key, no account, no quota.
#
# Metals and forex come from Swissquote's public live quotes, with Yahoo
# Finance as the forex fallback. Indices and oil are not monitored: no free
# feed tracks their CFD prices in real time.
# All feeds are 100% public, keyless, and free.

# --- Broker execution: SHELVED ---
#
# broker_api.py is still in the repo but bot.py no longer calls it, so the
# BROKER_* variables have no effect. See MT5_MOBILE_AUTOMATION.md before
# wiring it back up.

# --- Optional features: each switches on when its keys are set ---

# Keep monitored trades and results through restarts and deploys (Render's
# free plan wipes local files). Free Redis at https://console.upstash.com ->
# your database -> REST API.
#UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
#UPSTASH_REDIS_REST_TOKEN=

# Backup chart reader, used when Groq's per-minute limit is full.
# Free key: https://aistudio.google.com/apikey
#GEMINI_API_KEY=

# Your Telegram user id (ask @userinfobot): receives error alerts and a
# notice whenever the bot starts.
#ADMIN_CHAT_ID=

# --- Optional settings (defaults shown) ---

# How hard the vision model thinks before answering (none/low/medium/high)
#VISION_REASONING_EFFORT=medium

# Time zone for the Sunday 20:00 results summary and news times
#LOCAL_TIMEZONE=Africa/Lagos

# How often to poll live quotes (metals, forex), in seconds. Crypto candles
# are polled every 15 s regardless. Requests scale with the number of distinct
# symbols being watched, not the number of trades.
#MONITOR_INTERVAL=5

# Stop monitoring a trade after this many hours with no TP/SL (0 = never)
#TRADE_TTL_HOURS=72

# Where to persist chat IDs and monitored trades. Point this at a mounted
# persistent disk if you want state to survive redeploys.
#STATE_FILE=state.json


